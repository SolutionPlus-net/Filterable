{
    "name": "otas/filterable",
    "description": "a laravel package to filter model results is breeze",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Ahmed Mabrouk",
            "email": "a.mabrouk25@gmail.com"
        },
        {
            "name": "Omar Ashraf",
            "email": "o.ashraf@otas.net"
        }
    ],
    "minimum-stability": "dev",
    "require": {
        "laravel/framework": ">=6.0"
    },
    "require-dev": {
        "orchestra/testbench": "^7.0@dev"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Otas\\Filterable\\FilterableServiceProvider"
            ]
        }
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Otas\\Filterable\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    }
}
